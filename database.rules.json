{
  "rules": {
    "board": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('j').isString() && newData.child('j').val().length < 3000"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('j').isString() && newData.child('j').val().length < 300000"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.child('p').isString() && newData.child('p').val().length < 4000)"
        }
      }
    }
  }
}
